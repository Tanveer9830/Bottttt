{
  "name": "sentinel-discord-bot",
  "version": "0.1.0",
  "private": true,
  "description": "A secure, modular Discord administration bot",
  "type": "module",
  "main": "src/index.js",
  "engines": { "node": ">=20.11.0" },
  "scripts": {
    "start": "node src/index.js",
    "register": "node scripts/register-commands.js",
    "inventory": "node scripts/generate-inventory.js",
    "check": "node --check src/index.js && node scripts/validate-commands.js",
    "test": "node --test"
  },
  "dependencies": {
    "discord.js": "^14.22.1",
    "pino": "^9.9.4"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.1"
  }
}
